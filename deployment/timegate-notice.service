[Unit]
Description=Times Gate five-screen notice service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/timegate-notice/current
EnvironmentFile=%h/.config/timegate-notice/service.env
ExecStart=/usr/bin/python3 %h/.local/share/timegate-notice/current/service.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
